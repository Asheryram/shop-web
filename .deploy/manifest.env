# How the infra platform runs this repo. (Copied from infra/app-kit and filled in.)
APP_NAME=shop-web
TYPE=frontend
# On a real server with GitHub: ghcr.io/<owner>/shop-web   — locally: images built on the server itself
IMAGE_REPO=local/shop-web

WEB_CONTEXT=.
WEB_PORT=80
WEB_MEM_LIMIT=64m
WEB_CPUS=0.25

# Which backend to talk to: a shop-api preview built from the SAME branch name if there is one,
# otherwise shop-api's develop. DevOps can override this any time in the console.
BACKEND_APP=shop-api
BACKEND_FALLBACK_ENV=develop
